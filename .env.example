# ===========================================
# Instituto UP - Painel Administrativo
# ===========================================
# Copie este arquivo para .env.local e preencha os valores.
# cp .env.example .env.local

# Connection string do PostgreSQL
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Banco do KanbanCW usado para consolidar cards/etapas na produtividade
KANBANCW_DATABASE_URL=
KANBANCW_PUBLIC_URL=https://up-chatwoot-proxy.vercel.app/kanban
KANBANCW_PG_SSL=false

# Habilitar SSL na conexao com o banco (true para provedores como Aiven, Neon, Vercel Postgres)
PG_SSL=true

# Token legado para automacoes via Authorization: Bearer.
# O login web da dashboard usa os usuarios e senhas do Chatwoot.
DASHBOARD_TOKEN=

# Segredo dedicado para assinar o cookie de sessao
# Use um valor longo, aleatorio e diferente do DASHBOARD_TOKEN
DASHBOARD_SESSION_SECRET=gere_um_segredo_longo_e_unico

# Mostrar tambem registros de formulario ainda nao marcados como _final=true
DASHBOARD_INCLUDE_INCOMPLETE=false

# Chatwoot usado para login, mensagens e sincronizacao de contatos
# No Docker local: http://chatwoot-rails:3000
CHATWOOT_INTERNAL_URL=http://chatwoot-rails:3000

# Banco do Chatwoot usado para ler mensagens e sincronizar contatos
# No Docker local: postgresql://postgres:chatwoot@chatwoot-postgres:5432/chatwoot_dev
CHATWOOT_DATABASE_URL=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_FRONTEND_URL=https://up-chatwoot-proxy.vercel.app
CHATWOOT_DEFAULT_INBOX_ID=
CHATWOOT_PG_SSL=false

# Usuarios que podem verificar produtividade e distribuir leads.
# Administradores do Chatwoot tambem sao considerados gestores.
# Exemplo: gestor@empresa.com,supervisor@empresa.com
PRODUCTIVITY_MANAGER_EMAILS=

# Inbox unico para o primeiro contato comercial compartilhado por todos.
COMMERCIAL_SHARED_INBOX_ID=

# Configuracao de treinamentos ativos (JSON)
# Exemplo: [{"id":"2026-03-01","label":"Turma Marco 2026","startsAt":"2026-03-01T09:00:00Z"}]
TRAINING_CONFIG=[]
