# ===========================================
# Instituto UP - Painel Administrativo
# ===========================================
# Copie este arquivo para .env.local e preencha os valores.
# cp .env.example .env.local

# Connection string do PostgreSQL
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Banco do KanbanCW usado para consolidar cards/etapas na produtividade
KANBANCW_DATABASE_URL=
KANBANCW_PUBLIC_URL=https://up-chatwoot-proxy.vercel.app/kanban
KANBANCW_PG_SSL=false

# Habilitar SSL na conexao com o banco (true para provedores como Aiven, Neon, Vercel Postgres)
PG_SSL=true

# Token legado para automacoes via Authorization: Bearer.
# O login web da dashboard usa os usuarios e senhas do Chatwoot.
DASHBOARD_TOKEN=

# Segredo dedicado para assinar o cookie de sessao
# Use um valor longo, aleatorio e diferente do DASHBOARD_TOKEN
DASHBOARD_SESSION_SECRET=gere_um_segredo_longo_e_unico

# Mostrar tambem registros de formulario ainda nao marcados como _final=true
DASHBOARD_INCLUDE_INCOMPLETE=false

# Chatwoot usado para login, mensagens e sincronizacao de contatos
# No Docker local: http://chatwoot-rails:3000
CHATWOOT_INTERNAL_URL=http://chatwoot-rails:3000

# Banco do Chatwoot usado para ler mensagens e sincronizar contatos
# No Docker local: postgresql://postgres:chatwoot@chatwoot-postgres:5432/chatwoot_dev
CHATWOOT_DATABASE_URL=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_FRONTEND_URL=https://up-chatwoot-proxy.vercel.app
CHATWOOT_DEFAULT_INBOX_ID=
CHATWOOT_PG_SSL=false

# Usuarios que podem verificar produtividade e distribuir leads.
# Administradores do Chatwoot tambem sao considerados gestores.
# Exemplo: gestor@empresa.com,supervisor@empresa.com
PRODUCTIVITY_MANAGER_EMAILS=

# Inbox unico para o primeiro contato comercial compartilhado por todos.
COMMERCIAL_SHARED_INBOX_ID=

# Configuracao de treinamentos ativos (JSON)
# Exemplo: [{"id":"2026-03-01","label":"Turma Marco 2026","startsAt":"2026-03-01T09:00:00Z"}]
TRAINING_CONFIG=[]

# Webhook de Lead Ads do Facebook (dashboard/app/api/vozup/facebook-webhook)
# FACEBOOK_WEBHOOK_VERIFY_TOKEN: string qualquer que voce escolhe e informa
#   de novo no campo "Verify Token" ao cadastrar o webhook no Meta App.
# FACEBOOK_APP_SECRET: em Meta App > Configuracoes > Basico > Chave secreta do aplicativo.
# FACEBOOK_PAGE_ACCESS_TOKEN: token de acesso de Pagina (permanente, sem expirar)
#   com os escopos leads_retrieval e pages_manage_ads.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Fallback: consulta periodicamente os leads recentes da Meta e importa os que
# nao chegaram por webhook. Deixe ligado em producao.
FACEBOOK_LEAD_SYNC_ENABLED=true
FACEBOOK_LEAD_SYNC_INTERVAL_MS=120000
FACEBOOK_LEAD_SYNC_LIMIT=25
FACEBOOK_LEAD_SYNC_FORM_LIMIT=50

# Metricas de Campanha (Meta Ads): reusa o FACEBOOK_PAGE_ACCESS_TOKEN acima
# (ja tem escopo ads_management/ads_read). META_ADS_AD_ACCOUNT_ID e a conta
# de anuncios (com ou sem o prefixo "act_"). server.js + lib/metaAds.ts.
META_ADS_AD_ACCOUNT_ID=
META_ADS_SYNC_ENABLED=true
META_ADS_SYNC_INTERVAL_MS=900000
META_ADS_INSIGHTS_RESYNC_DAYS=3
META_ADS_STRUCTURE_TTL_HOURS=6
META_ADS_INITIAL_BACKFILL_DAYS=90

# Varredura da fila de merge por telefone (server.js + lib/mergeSweep.ts).
# So roda quando o processo e iniciado via "node server.js" (nao via
# "next dev"/"next start"). Usa o DASHBOARD_TOKEN acima para se autenticar.
MERGE_SWEEP_ENABLED=true
MERGE_SWEEP_INTERVAL_MS=30000

# Web push de leads novos para os celulares dos vendedores (server.js +
# lib/pushNotifications.ts). Requer HTTPS em producao. As chaves VAPID sao
# geradas automaticamente e guardadas no banco na primeira execucao; as
# variaveis abaixo so precisam ser definidas para sobrepo-las.
PUSH_DISPATCH_ENABLED=true
PUSH_DISPATCH_INTERVAL_MS=30000
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@vozup.com.br
